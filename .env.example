# Database
# Local development uses SQLite. For production (Vercel/Render), create a free
# Neon Postgres database (neon.tech), set DATABASE_URL to its connection string,
# and change `provider = "sqlite"` to `provider = "postgresql"` in
# prisma/schema.prisma. See README "Deploying" for the exact steps.
DATABASE_URL="file:./dev.db"

# Admin dashboard (generated; change if you prefer your own)
ADMIN_EMAIL="admin@luxofy.in"
ADMIN_PASSWORD="choose-a-strong-password"
JWT_SECRET="generate-with: openssl rand -hex 32"

# --- Email via Gmail SMTP (free) ---
# Used for OTP codes and confirmation emails.

SMTP_HOST=
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# --- Optional free integrations (features activate automatically when keys are set) ---

# Slack incoming webhook for sales notifications (free)
SLACK_WEBHOOK_URL=""

# WhatsApp Business Cloud API (optional; the site already uses free wa.me links)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Meta Conversions API (free with a Meta ad account)
META_PIXEL_ID=""
META_CAPI_TOKEN=""

# Client-side analytics, all free (rendered only when set)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""

# Cloudflare Turnstile bot protection (free)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Public site URL (used in metadata, sitemap, calendar invites).
# Set to your real domain or Vercel URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
